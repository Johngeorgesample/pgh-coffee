      {
        "id": 11,
        "type": "bargauge",
        "title": "Roaster link clicks",
        "description": "Clicks from the calendar through to a roaster's page on the map, from the roster sidebar or a jar's page.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 16,
          "y": 22,
          "w": 8,
          "h": 27
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum by (event_data_roaster) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventRoasterClicked\" | logfmt | event_name=\"AdventRoasterClicked\" | page_url=~\"https?://$host.*\" [$__range]))",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "basic",
          "showUnfilled": true,
          "valueMode": "text",
          "namePlacement": "left",
          "sizing": "manual",
          "maxVizHeight": 22,
          "minVizHeight": 16,
          "text": {
            "titleSize": 13,
            "valueSize": 18
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "values": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "locale",
            "decimals": 0,
            "color": {
              "mode": "fixed",
              "fixedColor": "#FDE047"
            },
            "min": 0,
            "displayName": "${__data.fields.event_data_roaster}"
          },
          "overrides": []
