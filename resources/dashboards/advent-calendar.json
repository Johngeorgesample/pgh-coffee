      {
        "id": 13,
        "type": "piechart",
        "title": "Order chosen",
        "description": "Which order visitors locked in. Useful for deciding whether next year needs more than one.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 0,
          "y": 50,
          "w": 8,
          "h": 8
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum by (event_data_order) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventOrderChosen\" | logfmt | event_name=\"AdventOrderChosen\" | page_url=~\"https?://$host.*\" [$__range]))",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          }
        ],
        "options": {
          "pieType": "donut",
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": [
              "value",
              "percent"
            ]
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "values": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "locale",
            "decimals": 0,
            "displayName": "${__data.fields.event_data_order}"
          },
          "overrides": []
