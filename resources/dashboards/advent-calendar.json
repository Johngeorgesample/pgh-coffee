{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "pgh-coffee-advent-calendar",
    "annotations": {
      "grafana.app/folder": "pgh-coffee"
    }
  },
  "spec": {
    "title": "Advent calendar engagement",
    "tags": [
      "pgh-coffee",
      "advent"
    ],
    "timezone": "America/New_York",
    "schemaVersion": 39,
    "time": {
      "from": "2026-11-28T00:00:00.000Z",
      "to": "2026-12-31T23:59:59.000Z"
    },
    "templating": {
      "list": [
        {
          "type": "custom",
          "name": "host",
          "label": "Site",
          "query": "pgh.coffee,localhost:3000",
          "current": {
            "text": "pgh.coffee",
            "value": "pgh.coffee"
          },
          "options": [
            {
              "text": "pgh.coffee",
              "value": "pgh.coffee",
              "selected": true
            },
            {
              "text": "localhost:3000",
              "value": "localhost:3000",
              "selected": false
            }
          ]
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Engagement through the month",
        "collapsed": false,
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": []
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Calendar visitors",
        "description": "Distinct browser sessions that loaded any /advent page in the time range.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 0,
          "y": 1,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "count(sum by (session_id) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} | logfmt | page_id=~\"/advent.*\" | page_url=~\"https?://$host.*\" [$__range])))",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "none",
          "graphMode": "none",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "locale",
            "noValue": "0",
            "decimals": 0
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Jars opened",
        "description": "First visits to a jar's page. Revisits aren't counted.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 6,
          "y": 1,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum(count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventJarOpened\" | logfmt | event_name=\"AdventJarOpened\" | page_url=~\"https?://$host.*\" [$__range])) or vector(0)",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "none",
          "graphMode": "none",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "locale",
            "noValue": "0",
            "decimals": 0
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Cups logged",
        "description": "Tasting notes saved to an account.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 12,
          "y": 1,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum(count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventCupSaved\" | logfmt | event_name=\"AdventCupSaved\" | page_url=~\"https?://$host.*\" [$__range])) or vector(0)",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "none",
          "graphMode": "none",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "locale",
            "noValue": "0",
            "decimals": 0
          },
          "overrides": []
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "Accounts from the save prompt",
        "description": "Visitors who were asked to sign in to save a cup and came back signed in.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 18,
          "y": 1,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum(count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventSaveAuthCompleted\" | logfmt | event_name=\"AdventSaveAuthCompleted\" | page_url=~\"https?://$host.*\" [$__range])) or vector(0)",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "none",
          "graphMode": "none",
          "textMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "locale",
            "noValue": "0",
            "decimals": 0
          },
          "overrides": []
        }
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Calendar visitors per day",
        "description": "Distinct sessions that loaded an /advent page each day. Your shape check: strong start, a mid-month dip, and how far it recovers by the 25th. Days are UTC, so a bar starts at 7pm Pittsburgh time.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "count(sum by (session_id) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} | logfmt | page_id=~\"/advent.*\" | page_url=~\"https?://$host.*\" [1d])))",
            "legendFormat": "visitors",
            "queryType": "range"
          }
        ],
        "interval": "1d",
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "min": 0,
            "custom": {
              "drawStyle": "bars",
              "barAlignment": -1,
              "fillOpacity": 80,
              "lineWidth": 0,
              "stacking": {
                "mode": "none"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "Jars opened per day, by timing",
        "description": "today = opened on its day, catchup = an earlier jar opened late, early = opened before its day. Lots of catch-up late in the month means people are coming back after a gap.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 0,
          "y": 13,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum by (event_data_timing) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventJarOpened\" | logfmt | event_name=\"AdventJarOpened\" | page_url=~\"https?://$host.*\" [1d]))",
            "legendFormat": "{{event_data_timing}}",
            "queryType": "range"
          }
        ],
        "interval": "1d",
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "min": 0,
            "custom": {
              "drawStyle": "bars",
              "barAlignment": -1,
              "fillOpacity": 80,
              "lineWidth": 0,
              "stacking": {
                "mode": "normal"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 8,
        "type": "timeseries",
        "title": "Cups logged per day",
        "description": "Tasting notes saved each day: the deepest form of engagement on the page.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 12,
          "y": 13,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum(count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventCupSaved\" | logfmt | event_name=\"AdventCupSaved\" | page_url=~\"https?://$host.*\" [1d])) or vector(0)",
            "legendFormat": "cups",
            "queryType": "range"
          }
        ],
        "interval": "1d",
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "min": 0,
            "custom": {
              "drawStyle": "bars",
              "barAlignment": -1,
              "fillOpacity": 80,
              "lineWidth": 0,
              "stacking": {
                "mode": "none"
              }
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 9,
        "type": "row",
        "title": "Which brands drive engagement",
        "collapsed": false,
        "gridPos": {
          "x": 0,
          "y": 21,
          "w": 24,
          "h": 1
        },
        "panels": []
      },
      {
        "id": 10,
        "type": "table",
        "title": "Engagement by jar",
        "description": "One row per jar, labelled with its roaster. Opens follow where a jar falls in the month as much as the brand, so compare brands on save rate and rating, which don't depend on how many people were around that day. Jars sit on different days in the North-to-south and Oldest-first orders, which also helps separate brand from date.",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "gridPos": {
          "x": 0,
          "y": 22,
          "w": 16,
          "h": 27
        },
        "targets": [
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "A",
            "expr": "sum by (event_data_jar) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventJarOpened\" | logfmt | event_name=\"AdventJarOpened\" | page_url=~\"https?://$host.*\" [$__range]))",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          },
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "B",
            "expr": "sum by (event_data_jar) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventCupSaved\" | logfmt | event_name=\"AdventCupSaved\" | page_url=~\"https?://$host.*\" [$__range]))",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          },
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "C",
            "expr": "avg by (event_data_jar) (avg_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventCupSaved\" | logfmt | event_name=\"AdventCupSaved\" | page_url=~\"https?://$host.*\" | event_data_rating > 0 | unwrap event_data_rating [$__range]))",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          },
          {
            "datasource": {
              "type": "loki",
              "uid": "grafanacloud-logs"
            },
            "refId": "D",
            "expr": "sum by (event_data_jar) (count_over_time({service_name=\"pgh-coffee\", kind=\"event\"} |= \"AdventBrewVideoPlayed\" | logfmt | event_name=\"AdventBrewVideoPlayed\" | page_url=~\"https?://$host.*\" [$__range]))",
            "legendFormat": "",
            "queryType": "instant",
            "instant": true,
            "range": false
          }
        ],
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "renameByName": {
                "event_data_jar": "Jar",
                "Value #A": "Opened",
                "Value #B": "Cups logged",
                "Value #C": "Avg rating",
                "Value #D": "Video plays"
              }
            }
          },
          {
            "id": "calculateField",
            "options": {
              "mode": "binary",
              "alias": "Save rate",
              "binary": {
                "left": {
                  "matcher": {
                    "id": "byName",
                    "options": "Cups logged"
                  }
                },
                "operator": "/",
                "right": {
                  "matcher": {
                    "id": "byName",
                    "options": "Opened"
                  }
                }
              }
            }
          },
          {
            "id": "sortBy",
            "options": {
              "sort": [
                {
                  "field": "Opened",
                  "desc": true
                }
              ]
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "noValue": "\u2013",
            "color": {
              "mode": "fixed",
              "fixedColor": "#FDE047"
            },
            "min": 0
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Jar"
              },
              "properties": [
                {
